# Canonical origin. Falls back to https://brainquiz.study when unset.
NEXT_PUBLIC_SITE_URL=https://brainquiz.study

# Umami analytics — cookieless, so no consent banner is required.
# Both must be set or the script is not injected at all (see app/layout.tsx).
#   URL: the script endpoint, e.g. https://cloud.umami.is/script.js
#   ID:  the website id shown in Umami after adding the site
# Events already instrumented: quiz-start, quiz-complete, theme-toggle
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_ID=
